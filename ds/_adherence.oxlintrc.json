        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='font'] > Literal[value!=/^(?:display|serif|sans|fat|marker)$/]",
        "message": "<DisplayTitle> font must be one of 'display' | 'serif' | 'sans' | 'fat' | 'marker'."
